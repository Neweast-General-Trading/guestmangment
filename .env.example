# SQLite file used by Prisma (relative to /prisma)
DATABASE_URL="file:./dev.db"

# Session signing key — generate a long random string for production
AUTH_SECRET="change-me"

# Public branding and URLs
NEXT_PUBLIC_APP_NAME="NEWEAST Guest Management"
NEXT_PUBLIC_APP_URL="http://localhost:3088"
INTRANET_URL="https://intranet.neweast.cloud"
INTRANET_API_KEY=""

# SMTP (Office 365 / Exchange)
SMTP_HOST="smtp.office365.com"
SMTP_PORT="587"
SMTP_EHLO_NAME="guest.neweast.cloud"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="NEWEAST Guest Management <guest@neweast.co>"
MAIL_BCC=""
MAIL_DELIVER_TO=""

# Guest mailbox IMAP (visit requests and room replies)
GUEST_INBOX_USER=""
GUEST_INBOX_PASS=""
GUEST_INBOX_HOST="outlook.office365.com"
GUEST_INBOX_PORT="993"

# Microsoft Graph (HQ room calendars)
GRAPH_TENANT_ID=""
GRAPH_CLIENT_ID=""
GRAPH_CLIENT_SECRET=""
GRAPH_MAILBOX="guest@neweast.co"

# Optional: SQL Server payroll directory
SQL_DB_USER=""
SQL_DB_PASSWORD=""
SQL_DB_SERVER=""
SQL_DB_DATABASE=""

# Optional: SAP HANA
HANA_DB_HOST=""
HANA_DB_PORT="30015"
HANA_DB_USER=""
HANA_DB_CREDENTIAL=""

# Notifications
NOTIFY_INBOX=""
NOTIFY_FANOUT=""
TEAMS_API=""
TEAMS_WEBHOOK=""
GIFT_OWNER_EMAIL=""
GATE_PASS_OWNER_EMAIL=""

# Optional: email intake extraction
ANTHROPIC_API_KEY=""
